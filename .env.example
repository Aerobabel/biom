PORT=3000
# Set to your admin account email before deploying. Never put credentials here.
ADMIN_EMAIL=
# Render provides this from your Postgres instance.
DATABASE_URL=
# Only set for a PostgreSQL server that requires TLS with a trusted certificate.
DATABASE_SSL=false
# For local development SQLite is used in ./data. For a paid persistent disk:
# DATA_DIR=/var/data/biom
